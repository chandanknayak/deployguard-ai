# DeployGuard AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080

# Public URL of this server (used for dashboard links in PR comments)
# For local dev: use your ngrok URL e.g. https://abc123.ngrok-free.app
# For production: your deployed domain e.g. https://deployguard.yourcompany.com
PUBLIC_URL=https://your-deployguard-server.com

# ──────────────────────────────────────────
# GitHub Integration
# ──────────────────────────────────────────
# The secret you set in GitHub → Settings → Webhooks → Secret
GITHUB_WEBHOOK_SECRET=your-super-secret-webhook-token

# Personal Access Token OR GitHub App Installation Token
# Required scopes: repo (read), statuses (write), pull_requests (write)
# Create at: https://github.com/settings/tokens/new
GITHUB_API_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# For GitHub Enterprise:
# GITHUB_API_BASE_URL=https://github.yourcompany.com/api/v3

# ──────────────────────────────────────────
# MongoDB Atlas
# ──────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=deployguard

# ──────────────────────────────────────────
# OpenAI (LLM Agent + Embeddings)
# ──────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ──────────────────────────────────────────
# Analysis Limits
# ──────────────────────────────────────────
MAX_DIFF_FILES=200
SUPPORTED_AST_LANGUAGES=python
MAX_PAYLOAD_SIZE_BYTES=10485760

# ──────────────────────────────────────────
# Dashboard API (used by Streamlit dashboard to poll results)
# ──────────────────────────────────────────
# Same as APP_PORT above
DASHBOARD_API_URL=http://localhost:8080
